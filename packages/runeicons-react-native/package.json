{
  "name": "runeicons-react-native",
  "version": "0.1.0",
  "description": "Rune Icons for React Native \u2014 908 icons across five styles, as react-native-svg components.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "runeicons-react-native-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./manifest": {
      "runeicons-react-native-source": "./src/manifest.ts",
      "types": "./lib/typescript/src/manifest.d.ts",
      "default": "./lib/module/manifest.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "runeicons-react-native-source": "./src/icons/*.tsx",
      "types": "./lib/typescript/src/icons/*.d.ts",
      "default": "./lib/module/icons/*.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "icons": "node scripts/prepare-svg.mjs && svgr --config-file svgr.config.cjs -- svg",
    "build": "bob build",
    "clean": "del-cli lib svg src/icons src/manifest.ts",
    "prepare": "yarn icons && bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "example": "yarn workspace runeicons-react-native-example"
  },
  "keywords": [
    "runeicons",
    "icons",
    "react-native",
    "react-native-svg",
    "expo",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexvyn/runeicons.git",
    "directory": "packages/runeicons-react-native"
  },
  "author": "Gursahb Singh <gursahb7@gmail.com> (https://gs-rumana.com)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Nexvyn/runeicons/issues"
  },
  "homepage": "https://github.com/Nexvyn/runeicons/tree/main/packages/runeicons-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@svgr/cli": "^8.1.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-svg": "^15.15.5",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-svg": ">=15.0.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "sideEffects": false
}
